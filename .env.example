# Speranza CRM — Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://crm_user:changeme@db:5432/crm_prod
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crm_prod

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Auth
SECRET_KEY=change-this-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# SendGrid
SENDGRID_API_KEY=SG.your-api-key-here
FROM_EMAIL=team@sarsonfunds.com
FROM_NAME=Sarson Funds

# App
ENVIRONMENT=production
FRONTEND_URL=http://localhost
