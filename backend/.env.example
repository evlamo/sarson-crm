# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/crm_dev

# ── Security ───────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-min-32-chars
ENVIRONMENT=development

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── SendGrid ──────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxx
SENDGRID_FROM_EMAIL=crm@sarsonfunds.com
# ECDSA public key from SendGrid Event Webhook settings
SENDGRID_WEBHOOK_VERIFICATION_KEY=your-sendgrid-webhook-verification-key

# ── Mailchimp ─────────────────────────────────────────────────────────────
MAILCHIMP_API_KEY=xxxx-us1
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_AUDIENCE_ID=
# Shared secret for Mailchimp webhook verification
MAILCHIMP_WEBHOOK_SECRET=your-mailchimp-webhook-secret

# ── Application ───────────────────────────────────────────────────────────
MAX_USERS=15
FRONTEND_URL=http://localhost:3000

# Set to true in production to enforce @sarsonfunds.com domain or admin invite requirement
ENFORCE_DOMAIN_RESTRICTION=false
