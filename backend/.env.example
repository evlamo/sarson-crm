# Sarson CRM - Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# DATABASE
# ======================
DATABASE_URL=postgresql://crm_user:PASSWORD_HERE@localhost/crm_production

# ======================
# SECURITY
# ======================
# Generate SECRET_KEY: openssl rand -hex 32
SECRET_KEY=GENERATE_NEW_KEY_FOR_PRODUCTION

# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=GENERATE_NEW_FERNET_KEY_FOR_PRODUCTION

# ======================
# EMAIL SERVICE
# ======================
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ======================
# REDIS
# ======================
REDIS_URL=redis://localhost:6379/0

# ======================
# APPLICATION
# ======================
ENVIRONMENT=production
DEBUG=False
FRONTEND_URL=https://yourdomain.com

# ======================
# USER LIMITS
# ======================
MAX_USERS=10

# ======================
# DOMAIN RESTRICTIONS
# ======================
# Set to True to require @sarsonfunds.com or @speranza.local email for registration
# Set to False to allow any email with invite token
ENFORCE_DOMAIN_RESTRICTION=True

# ======================
# CORS
# ======================
ALLOWED_ORIGINS=https://yourdomain.com

# ======================
# TOKEN EXPIRATION
# ======================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ======================
# GOOGLE OAUTH (Optional)
# ======================
# Only needed if using Google Sheets integration or Google login
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ======================
# RATE LIMITING
# ======================
# Default limits are set in code, override here if needed
# RATE_LIMIT_ENABLED=True
